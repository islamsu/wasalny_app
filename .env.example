# Copy to .env for local development. Never commit real values.
# Server and staging MySQL database
# Use a disposable/non-production MySQL database for validation.
WASALNY_DATABASE_URL=
JWT_SECRET=
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=

# Server-side object storage
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Android Google Maps key. Restrict it to the production Android package and signing certificate.
GOOGLE_MAPS_ANDROID_API_KEY=

# Expo client
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_OAUTH_SERVER_URL=
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_OWNER_OPEN_ID=
EXPO_PUBLIC_OWNER_NAME=
EXPO_PUBLIC_API_BASE_URL=

# Optional preview/callback overrides
EXPO_WEB_PREVIEW_URL=
EXPO_PACKAGER_PROXY_URL=
